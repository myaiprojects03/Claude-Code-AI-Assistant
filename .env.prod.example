# Production (public demo) settings, Phase 8. Copy to .env.prod and fill in.
# The API and worker read ONLY .env.prod (ASSISTANT_ENV_FILE), never the dev .env.
# Never commit .env.prod (git-ignored).

# --- Addresses -----------------------------------------------------------------------
# With Tailscale Funnel: https://<pc>.<tailnet>.ts.net and the same with :8443.
# For a local dry run before Tailscale: http://localhost:8081 and http://localhost:8082.
PUBLIC_URL=http://localhost:8081
DASHBOARD_URL=http://localhost:8082

# --- Secrets (generate new ones; never reuse dev values) ------------------------------
# PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
APP_SECRET=
POSTGRES_PASSWORD=
KC_ADMIN_PASSWORD=
# Demo staff sign-ins (admin.dev / manager.dev / consultant.dev), set on every start.
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_PASSWORD=
DEMO_CONSULTANT_PASSWORD=

# --- App -----------------------------------------------------------------------------
APP_ENV=prod
API_PORT=8001
WORKER_METRICS_PORT=9102
TRUST_PROXY_HEADERS=true
# DATABASE_URL, OIDC_ISSUER, OIDC_JWKS_URL and ALLOWED_ORIGINS are derived by
# scripts/prod.ps1 from the values above; set them here only to override.

# --- Models (paste your keys yourself) ------------------------------------------------
LLM_CHAIN=groq,groq_alt,gemini
GROQ_API_KEY=
GEMINI_API_KEY=
INTERNAL_LLM_CHAIN=ollama
OLLAMA_MODEL=qwen2.5:3b

# --- Email to clients -----------------------------------------------------------------
# Free options: Gmail (smtp.gmail.com, 587, an app password) or Brevo free
# (smtp-relay.brevo.com, 587). Left as Mailpit, emails go to http://localhost:8025 only.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=assistant@acme.example

# --- Integrations: OFF for the public demo ---------------------------------------------
# Strangers use the demo. Point these at demo workspaces only, never the real ones.
SLACK_NOTIFY_WEBHOOK_URL=
SLACK_ALERT_WEBHOOK_URL=
TICKETING_PROVIDER=local
CRM_PROVIDER=local
CALENDAR_PROVIDER=local
