{
  "realm": "assistant",
  "enabled": true,
  "displayName": "AI Assistant (dev)",
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Full access, config publishing" },
      { "name": "manager", "description": "Views all conversations and analytics" },
      { "name": "consultant", "description": "Internal assistant, own escalations" }
    ]
  },
  "clients": [
    {
      "clientId": "assistant-dashboard",
      "name": "Dashboard + internal assistant",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "audience-assistant-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "assistant-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin.dev",
      "enabled": true,
      "email": "admin.dev@example.test",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "dev-admin-123", "temporary": false }],
      "realmRoles": ["admin"]
    },
    {
      "username": "manager.dev",
      "enabled": true,
      "email": "manager.dev@example.test",
      "emailVerified": true,
      "firstName": "Max",
      "lastName": "Manager",
      "credentials": [{ "type": "password", "value": "dev-manager-123", "temporary": false }],
      "realmRoles": ["manager"]
    },
    {
      "username": "consultant.dev",
      "enabled": true,
      "email": "consultant.dev@example.test",
      "emailVerified": true,
      "firstName": "Cora",
      "lastName": "Consultant",
      "credentials": [{ "type": "password", "value": "dev-consultant-123", "temporary": false }],
      "realmRoles": ["consultant"]
    }
  ]
}
