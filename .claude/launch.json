{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/uvicorn.exe",
      "runtimeArgs": ["assistant.api.main:app", "--app-dir", "apps/api/src", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "widget",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/widget", "run", "dev"],
      "port": 5173
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web", "run", "dev"],
      "port": 3000
    }
  ]
}
