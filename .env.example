# Copy to .env and fill in. Never commit .env.
APP_ENV=dev
APP_SECRET=change-me-to-a-long-random-string

DATABASE_URL=postgresql+asyncpg://assistant:assistant-dev@localhost:5433/assistant
# Used by DB tests; tests are skipped when unset.
TEST_DATABASE_URL=postgresql+asyncpg://assistant:assistant-dev@localhost:5433/assistant_test

# --- LLM (free stack) ---
# Comma-separated order: first is primary, the rest are fallbacks.
LLM_CHAIN=groq,groq_alt,gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Second free Groq model (separate rate limit), used when the first is rate-limited.
GROQ_ALT_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
# Claude adapter exists but is disabled (paid). Leave false.
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Auth (Keycloak) ---
OIDC_ISSUER=http://localhost:8080/realms/assistant
OIDC_AUDIENCE=assistant-api

# --- Email (Mailpit in dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=assistant@example.test

# --- Alerts / notifications ---
# Slack incoming webhooks (free). NOTIFY: handovers, bookings, tickets, reminders.
# ALERT: system failures. Leave empty to log instead. Check with: assistant-check-integrations
SLACK_NOTIFY_WEBHOOK_URL=
SLACK_ALERT_WEBHOOK_URL=

# --- Ticketing: local (our DB only) or jira (free Jira Cloud site + API token) ---
TICKETING_PROVIDER=local
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SUP
JIRA_ISSUE_TYPE=Task

# --- Knowledge base (local CPU embeddings, free) ---
EMBEDDER=fastembed
KB_MIN_SCORE=0.55

# --- CRM: local (our DB only) or hubspot (free CRM, private-app token) ---
CRM_PROVIDER=local
HUBSPOT_TOKEN=

# --- Calendar: local (our DB only) or google (free service account JSON) ---
CALENDAR_PROVIDER=local
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Public web chat ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=20
